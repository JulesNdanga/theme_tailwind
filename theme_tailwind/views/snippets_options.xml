<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tailwind CSS Integration -->
    <template id="assets_frontend" inherit_id="website.assets_frontend">
        <xpath expr="." position="inside">
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tailwindcss@3.1.8/dist/tailwind.min.css"/>
        </xpath>
    </template>

    <!-- Custom Snippets -->
    <template id="s_tailwind_hero" name="Tailwind Hero">
        <section class="s_cover pt96 pb96 o_cc o_cc5">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-6">
                        <h1 class="display-3">Your Amazing Headline</h1>
                        <p class="lead">Describe your service or product with this engaging text</p>
                        <a href="#" class="btn btn-primary btn-lg">Get Started</a>
                    </div>
                    <div class="col-lg-6">
                        <img src="/web/image/website.library_image_10" alt="Hero" class="img-fluid rounded"/>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <template id="s_tailwind_features" name="Tailwind Features">
        <section class="pt96 pb96">
            <div class="container">
                <div class="row">
                    <div class="col-lg-4 mb-4">
                        <div class="text-center">
                            <i class="fa fa-star fa-3x text-primary mb-3"></i>
                            <h4>Feature One</h4>
                            <p class="text-muted">Description of your first feature</p>
                        </div>
                    </div>
                    <div class="col-lg-4 mb-4">
                        <div class="text-center">
                            <i class="fa fa-rocket fa-3x text-primary mb-3"></i>
                            <h4>Feature Two</h4>
                            <p class="text-muted">Description of your second feature</p>
                        </div>
                    </div>
                    <div class="col-lg-4 mb-4">
                        <div class="text-center">
                            <i class="fa fa-check fa-3x text-primary mb-3"></i>
                            <h4>Feature Three</h4>
                            <p class="text-muted">Description of your third feature</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- Snippet Options -->
    <template id="snippet_options" inherit_id="website.snippet_options">
        <xpath expr="//div[@id='snippet_structure']//t[@t-snippet='s_cover']" position="after">
            <t t-snippet="theme_tailwind.s_tailwind_hero" t-thumbnail="/theme_tailwind/static/src/img/snippets/s_hero.jpg"/>
            <t t-snippet="theme_tailwind.s_tailwind_features" t-thumbnail="/theme_tailwind/static/src/img/snippets/s_features.jpg"/>
        </xpath>
    </template>
</odoo>
