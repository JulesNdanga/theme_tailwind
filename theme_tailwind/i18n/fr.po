#. module: theme_tailwind
#: model:ir.ui.view,arch_db:theme_tailwind.contact_form_section
msgid "Get In Touch"
msgstr "Contactez-nous"

#: model:ir.ui.view,arch_db:theme_tailwind.contact_form_section
msgid "Have a question or want to work together? Fill out the form below and we will get back to you soon."
msgstr "Vous avez une question ou souhaitez travailler ensemble ? Remplissez le formulaire ci-dessous et nous vous répondrons rapidement."

#: model:ir.ui.view,arch_db:theme_tailwind.contact_form_section
msgid "Your Name"
msgstr "Votre nom"

#: model:ir.ui.view,arch_db:theme_tailwind.contact_form_section
msgid "Enter your full name"
msgstr "Entrez votre nom complet"

#: model:ir.ui.view,arch_db:theme_tailwind.contact_form_section
msgid "Email Address"
msgstr "Adresse e-mail"

#: model:ir.ui.view,arch_db:theme_tailwind.contact_form_section
msgid "your@email.com"
msgstr "votre@email.com"

#: model:ir.ui.view,arch_db:theme_tailwind.contact_form_section
msgid "Phone Number"
msgstr "Numéro de téléphone"

#: model:ir.ui.view,arch_db:theme_tailwind.contact_form_section
msgid "(Optional)"
msgstr "(Optionnel)"

#: model:ir.ui.view,arch_db:theme_tailwind.contact_form_section
msgid "Company Name"
msgstr "Nom de l'entreprise"

#: model:ir.ui.view,arch_db:theme_tailwind.contact_form_section
msgid "Your company (Optional)"
msgstr "Votre entreprise (Optionnel)"

#: model:ir.ui.view,arch_db:theme_tailwind.contact_form_section
msgid "Subject"
msgstr "Sujet"

#: model:ir.ui.view,arch_db:theme_tailwind.contact_form_section
msgid "What is this about?"
msgstr "De quoi s'agit-il ?"

#: model:ir.ui.view,arch_db:theme_tailwind.contact_form_section
msgid "Message"
msgstr "Message"

#: model:ir.ui.view,arch_db:theme_tailwind.contact_form_section
msgid "Tell us more about your inquiry..."
msgstr "Parlez-nous de votre demande..."

#: model:ir.ui.view,arch_db:theme_tailwind.contact_form_section
msgid "I agree to the "
msgstr "J'accepte la "

#: model:ir.ui.view,arch_db:theme_tailwind.contact_form_section
msgid "privacy policy"
msgstr "politique de confidentialité"

#: model:ir.ui.view,arch_db:theme_tailwind.contact_form_section
msgid " and consent to having this website store my submitted information."
msgstr " et consens à ce que ce site web stocke les informations que j'ai soumises."

#: model:ir.ui.view,arch_db:theme_tailwind.contact_form_section
msgid "Send Message"
msgstr "Envoyer le message"

#: model:ir.ui.view,arch_db:theme_tailwind.contact_form_section
msgid "We typically respond within 24 hours"
msgstr "Nous répondons généralement sous 24 heures"

#: model:ir.ui.view,arch_db:theme_tailwind.contactus_thank_you
msgid "Thank You"
msgstr "Merci"

#: model:ir.ui.view,arch_db:theme_tailwind.contactus_thank_you
msgid "Thank You for Contacting Us!"
msgstr "Merci de nous avoir contactés !"

#: model:ir.ui.view,arch_db:theme_tailwind.contactus_thank_you
msgid "Your message has been successfully sent. We will get back to you within 24 hours."
msgstr "Votre message a été envoyé avec succès. Nous vous répondrons dans les 24 heures."

#: model:ir.ui.view,arch_db:theme_tailwind.contactus_thank_you
msgid "Return to Homepage"
msgstr "Retour à l'accueil"

