<odoo>
    <!--
        Contact Form integrated with Odoo CRM
        This form creates leads in the CRM module when submitted
        CSRF protection included for security
    -->
    
    <!-- Replace the static form in home.xml with this functional one -->
    <template id="contact_form_section" name="Contact Form Section">
        <section id="contact-form" class="py-20 bg-gradient-to-br from-blue-50 to-white dark:from-gray-900 dark:to-gray-800">
            <div class="container mx-auto px-6">
                <div class="text-center mb-12">
                    <h2 class="text-3xl md:text-4xl font-bold text-gray-800 dark:text-white mb-2">
                        <t t-esc="'Get In Touch'"/>
                    </h2>
                    <p class="text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
                        <t t-esc="'Have a question or want to work together? Fill out the form below and we will get back to you soon.'"/>
                    </p>
                </div>
                
                <div class="max-w-4xl mx-auto">
                    <form action="/website/form/" 
                          method="post" 
                          class="s_website_form bg-white dark:bg-gray-800 rounded-lg shadow-xl p-8 transform hover:scale-105 transition duration-300"
                          data-model_name="crm.lead"
                          data-success-page="/contactus-thank-you"
                          data-editable-mode="True">
                        
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                            <!-- Name -->
                            <div class="form-group">
                                <label for="contact_name" class="block text-gray-700 dark:text-gray-300 font-medium mb-2">
                                    <t t-esc="'Your Name'"/>
                                    <span class="text-red-500">*</span>
                                </label>
                                <input type="text" 
                                       name="contact_name" 
                                       class="form-control w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition" 
                                       required="1"
                                       t-att-placeholder="_('Enter your full name')"/>
                            </div>
                            
                            <!-- Email -->
                            <div class="form-group">
                                <label for="email_from" class="block text-gray-700 dark:text-gray-300 font-medium mb-2">
                                    <t t-esc="'Email Address'"/>
                                    <span class="text-red-500">*</span>
                                </label>
                                <input type="email" 
                                       name="email_from" 
                                       class="form-control w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition" 
                                       required="1"
                                       t-att-placeholder="_('your@email.com')"/>
                            </div>
                        </div>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                            <!-- Phone -->
                            <div class="form-group">
                                <label for="phone" class="block text-gray-700 dark:text-gray-300 font-medium mb-2">
                                    <t t-esc="'Phone Number'"/>
                                </label>
                                <input type="tel" 
                                       name="phone" 
                                       class="form-control w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
                                       t-att-placeholder="_('(Optional)')"/>
                            </div>
                            
                            <!-- Company -->
                            <div class="form-group">
                                <label for="partner_name" class="block text-gray-700 dark:text-gray-300 font-medium mb-2">
                                    <t t-esc="'Company Name'"/>
                                </label>
                                <input type="text" 
                                       name="partner_name" 
                                       class="form-control w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
                                       t-att-placeholder="_('Your company (Optional)')"/>
                            </div>
                        </div>
                        
                        <!-- Subject -->
                        <div class="form-group mb-6">
                            <label for="name" class="block text-gray-700 dark:text-gray-300 font-medium mb-2">
                                <t t-esc="'Subject'"/>
                                <span class="text-red-500">*</span>
                            </label>
                            <input type="text" 
                                   name="name" 
                                   class="form-control w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition" 
                                   required="1"
                                   t-att-placeholder="_('What is this about?')"/>
                        </div>
                        
                        <!-- Message -->
                        <div class="form-group mb-6">
                            <label for="description" class="block text-gray-700 dark:text-gray-300 font-medium mb-2">
                                <t t-esc="'Message'"/>
                                <span class="text-red-500">*</span>
                            </label>
                            <textarea name="description" 
                                      rows="6" 
                                      class="form-control w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition" 
                                      required="1"
                                      t-att-placeholder="_('Tell us more about your inquiry...')"></textarea>
                        </div>
                        
                        <!-- Privacy notice -->
                        <div class="form-group mb-6">
                            <label class="flex items-start">
                                <input type="checkbox" 
                                       name="privacy_consent" 
                                       class="mt-1 mr-2" 
                                       required="1"/>
                                <span class="text-sm text-gray-600 dark:text-gray-400">
                                    <t t-esc="'I agree to the '"/>
                                    <a href="/privacy-policy" class="text-blue-600 hover:underline">
                                        <t t-esc="'privacy policy'"/>
                                    </a>
                                    <t t-esc="' and consent to having this website store my submitted information.'"/>
                                </span>
                            </label>
                        </div>
                        
                        <!-- Submit Button -->
                        <div class="text-center">
                            <button type="submit" 
                                    class="bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white font-bold py-4 px-12 rounded-lg shadow-lg transform hover:scale-105 transition duration-300">
                                <t t-esc="'Send Message'"/>
                            </button>
                            <p class="mt-4 text-sm text-gray-500 dark:text-gray-400">
                                <t t-esc="'We typically respond within 24 hours'"/>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </section>
    </template>
    
    <!-- Thank you page after form submission -->
    <template id="contactus_thank_you" name="Contact Thank You" page="True">
        <t t-call="website.layout">
            <t t-set="title"><t t-esc="'Thank You'"/></t>
            <div class="container py-20 text-center">
                <div class="max-w-2xl mx-auto">
                    <div class="mb-8">
                        <svg class="w-24 h-24 mx-auto text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    <h1 class="text-4xl font-bold text-gray-800 dark:text-white mb-4">
                        <t t-esc="'Thank You for Contacting Us!'"/>
                    </h1>
                    <p class="text-xl text-gray-600 dark:text-gray-400 mb-8">
                        <t t-esc="'Your message has been successfully sent. We will get back to you within 24 hours.'"/>
                    </p>
                    <a href="/" class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-medium py-3 px-8 rounded-lg shadow-lg">
                        <t t-esc="'Return to Homepage'"/>
                    </a>
                </div>
            </div>
        </t>
    </template>
    
</odoo>
