<odoo>
    <!--
        This file extends the frontend assets to load our Tailwind CSS framework
        and any other static resources. Using a separate XML file for assets
        keeps the manifest clean. The Tailwind CSS file is loaded via CDN as
        recommended for light themes. Should you wish to self‑host or modify
        Tailwind, you could copy the compiled CSS into ``static/src/css`` and
        reference it here instead of the CDN URL.
    -->
    <template id="assets_frontend" inherit_id="website.assets_frontend" name="Base Tailwind Assets">
        <xpath expr="." position="inside">
            <!-- Import Tailwind CSS via CDN -->
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tailwindcss@3.1.8/dist/tailwind.min.css"/>
        </xpath>
    </template>
</odoo>