<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Homepage Template -->
    <record id="homepage" model="website.page">
        <field name="name">Tailwind Homepage</field>
        <field name="key">theme_tailwind.homepage</field>
        <field name="type">qweb</field>
        <field name="url">/</field>
        <field name="website_published">True</field>
        <field name="is_homepage">True</field>
        <field name="arch" type="xml">
            <t t-name="theme_tailwind.homepage">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">
                        <!-- Hero Section -->
                        <section class="s_cover o_cc o_cc5 pt96 pb96" style="background-image: none; background-color: rgb(59, 130, 246);">
                            <div class="o_we_bg_filter bg-black-50"></div>
                            <div class="container">
                                <div class="row align-items-center">
                                    <div class="col-lg-6 text-white">
                                        <h1 class="display-3 mb-3">We specialize in UI/UX, Web Development, Digital Marketing</h1>
                                        <p class="lead mb-4">Transform your digital presence with our expert services. We create stunning, high-converting websites tailored to your business needs.</p>
                                        <a href="/contactus" class="btn btn-lg btn-light">Get Started</a>
                                    </div>
                                    <div class="col-lg-6">
                                        <img src="/web/image/website.library_image_10" alt="Hero" class="img-fluid rounded shadow-lg"/>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <!-- Services Section -->
                        <section class="s_text_block pt96 pb96">
                            <div class="container">
                                <div class="row mb-4">
                                    <div class="col-lg-12 text-center">
                                        <h2 class="display-4 mb-3">Our Services</h2>
                                        <p class="lead text-muted">Comprehensive solutions for your digital success</p>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-4 mb-4">
                                        <div class="card h-100 shadow-sm">
                                            <div class="card-body text-center">
                                                <div class="mb-3">
                                                    <i class="fa fa-paint-brush fa-3x text-primary"></i>
                                                </div>
                                                <h4>24/7 Support</h4>
                                                <p class="text-muted">Round-the-clock assistance for all your needs</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-4 mb-4">
                                        <div class="card h-100 shadow-sm">
                                            <div class="card-body text-center">
                                                <div class="mb-3">
                                                    <i class="fa fa-users fa-3x text-primary"></i>
                                                </div>
                                                <h4>Take Ownership</h4>
                                                <p class="text-muted">Full control over your digital assets</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-4 mb-4">
                                        <div class="card h-100 shadow-sm">
                                            <div class="card-body text-center">
                                                <div class="mb-3">
                                                    <i class="fa fa-briefcase fa-3x text-primary"></i>
                                                </div>
                                                <h4>Team Work</h4>
                                                <p class="text-muted">Collaborative approach to every project</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <!-- Call to Action -->
                        <section class="s_call_to_action pt96 pb96 o_cc o_cc1">
                            <div class="container">
                                <div class="row">
                                    <div class="col-lg-8 offset-lg-2 text-center text-white">
                                        <h2 class="display-4 mb-3">Ready to Get Started?</h2>
                                        <p class="lead mb-4">Let's create something amazing together</p>
                                        <a href="/contactus" class="btn btn-lg btn-light">Contact Us</a>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
</odoo>
